# ==========================================
# FirmFlow Environment Configuration
# ==========================================

# General
DEBUG=True
SECRET_KEY=change-this-in-production-firmflow-super-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,web,api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# PostgreSQL Database
DB_NAME=firmflow_db
DB_USER=firmflow_user
DB_PASSWORD=firmflow_password_secret
DB_HOST=postgres
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="FirmFlow <notifications@firmflow.local>"

# PAN Encryption (32-byte urlsafe base64 key or hex)
PAN_ENCRYPTION_KEY=v8ZlXj6uF2y9qA4p7rT1w0m3k5L8oN2iP4eR6tY8uI0=

# Storage
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
STATIC_ROOT=/app/static
STATIC_URL=/static/
